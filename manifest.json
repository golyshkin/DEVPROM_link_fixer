{
  "manifest_version": 3,
  "name": "DEVPROM Link Fixer",
  "version": "3.13",
  "description": "DEVPROM link tool fixes the DEVPROM broken links to TXT/HTML user friendly MD, PUML, JIRA & HTML formats for any further usage. Supported a keywords for set the custom URL template. The pressed CTRL key keeps an original COPY/PAST behavior.",
  "author": "Alexander.Golyshkin",
  "homepage_url": "https://github.com/golyshkin/DEVPROM_link_fixer",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "options_page": "options/options.html",
  "icons": {
    "48": "icons/icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Show the DEVPROM Fixer Dialog."
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "Alexander.Golyshkin@ya.ru",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
            "required": [ "none" ]
          }    
    }
  },
  "action": {
    "default_title": "plugin",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.png"
    }
  },
  "content_scripts": [
    {
      "all_frames": true,
      "matches": [
        "*://devprom.e-kama.com/**"
      ],
      "js": [
        "devprom_link_fixer.js"
      ]
    }
  ]
}