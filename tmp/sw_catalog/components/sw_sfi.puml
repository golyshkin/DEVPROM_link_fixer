@startuml

@startuml

!global $participantSwSfiListStr = ""

!procedure $addSwSfiParticipant( $type, $name, $desc )
    ' Declare the participant
    !if $type == "actor"
        actor $name
    !elseif $type == "database"
        database $name
    !else
        participant $name [
        =$name
        ----
        ""$desc""
        ]

    !endif
    
    ' Add its name to a global list string
    !global $participantSwSfiListStr = $participantSwSfiListStr + "# " + "**" + $name + "** - " + $desc +"\n"
!endprocedure

$addSwIftParticipant( "participant", "IVI_SFI", "Safety Island ASIL-B" )

!if ($HELP == true )
  note across : **Declared SW SFI Actors**:\n\$participantSwSfiListStr
!endif

@enduml