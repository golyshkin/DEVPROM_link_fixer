@startuml

!global $swIftActorList = ""

!procedure $addSwIftActor( $type, $name, $desc )
    ' Declare the participant
    !if $type == "actor"
        actor $name
    !elseif $type == "database"
        database $name
    !else
        participant $name [
        =$name
        ----
        ""$desc""
        ]

    !endif
    
    ' Add its name to a global list string
    !global $swIftActorList = $swIftActorList + "# " + "**" + $name + "** - " + $desc +"\n"
!endprocedure

$addSwIftActor( "participant", "IVI_IFT", "Infotainment" )
$addSwIftActor( "participant", "IVI_OTA", "OTA Application" )

!if ($HELP == true )
  note across : **Declared SW IFT Actors**:\n$swIftActorList
!endif

@enduml