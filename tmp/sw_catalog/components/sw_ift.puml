@startuml

!global $participantSwIftListStr = ""

!procedure $addSwIftParticipant( $type, $name, $desc )
    ' Declare the participant
    !if $type == "actor"
        actor $name
    !elseif $type == "database"
        database $name
    !else
        participant $name [
        =$name
        ----
        ""$desc""
        ]

    !endif
    
    ' Add its name to a global list string
    !global $participantSwIftListStr = $participantSwIftListStr + "# " + "**" + $name + "** - " + $desc +"\n"
!endprocedure

$addSwIftParticipant( "participant", "IVI_IFT", "Infotainment" )
$addSwIftParticipant( "participant", "IVI_OTA", "OTA Application" )

!if ($HELP == true )
  note across : **Declared SW IFT Actors**:\n\$participantSwIftListStr
!endif

@enduml