@startuml

' Diagram common configuration
skinparam mainframeBorderColor #lightgrey
hide unlinked
!pragma teoz false

' PUML Framework defined variables 
!$URL_BASE = "https://raw.githubusercontent.com/golyshkin/DEVPROM_link_fixer/refs/heads/main/tmp"
!$COMP_NOTE = "Full Components Description - [[https://confluence.e-kama.com/display/IVI/Software+Subsystems Software Subsystems Page]]"

mainframe $DIAGRAM_ID - $DIAGRAM_VER: $DIAGRAM_TITLE\t
right header Author: $AUTHOR

!if ($HELP == true )
  !if ( $DIAGRAM_TYPE == "SEQ" )
     note across
  !elseif ( $DIAGRAM_TYPE == "SM" )
     note as FLOATING
  !else
     note
  !endif
  
    **HELP Menu:**
    \t
    Used Variables:
    \t
    # **HELP** = [true, false] - Show this Help
    # **URL_BASE** = [$URL_BASE] - The base PUML scripts location. Used for simplify '!include' definitions in framework & diagrams.
    # **AUTHOR** = [str] - The Diagram Author email (e.g. Aleksandr.Golyshkin@atom.ru)
    # **DIAGRAM_ID** = [str] - The Diagram Id which contains from pattern **DOMAIN-FEATURE-DIAGRAM_TYPE** (e.g. IVI-OTA-SEQ, IVI-OTA-UC, IVI-OTA-SM).
    # **DIAGRAM_VER** = [str] - The Diagram Version (e.g. v.1)
    # **DIAGRAM_TITLE** = [str] - The Diagram Title (e.g. OTA Initialization)
  end note
!endif

!procedure $defineActor( $type, $name, $desc, $stereotype )
    !if $type == "actor"
        actor $name
    !elseif $type == "database"
        database $name
    !else
        participant $name <<$stereotype>> [
        =$name
        ----
        ""$desc""
        ]
    !endif
!endprocedure

!function $addActor( $list, $type, $name, $desc, $stereotype = "none" )
   $defineActor( $type, $name, $desc, $stereotype )

   !if ($stereotype == "")
      !$stereotype = "none"
   !endif

   !return $list + "# " + "**" + $name + "** <<" + $stereotype + ">> - " + $desc + "\n"
!endfunction

@enduml